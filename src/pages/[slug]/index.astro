---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import CommuneNav from '../../components/CommuneNav.astro';
import Pillars from '../../components/Pillars.astro';
import Questions from '../../components/Questions.astro';
import Offre from '../../components/Offre.astro';
import Methode from '../../components/Methode.astro';
import RendezVous from '../../components/RendezVous.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import ConciergeBand from '../../components/ConciergeBand.astro';
import { SECTEURS, SITE, type Secteur } from '../../data/site';
import { COMMUNES } from '../../data/communes';
import type { Commune } from '../../data/types';

export function getStaticPaths() {
  return [
    ...SECTEURS.map((s) => ({ params: { slug: s.slug }, props: { kind: 'secteur', secteur: s } })),
    ...COMMUNES.map((c) => ({ params: { slug: c.slug }, props: { kind: 'commune', commune: c } })),
  ];
}

const { kind } = Astro.props as { kind: 'secteur' | 'commune' };
const secteur = Astro.props.secteur as Secteur | undefined;
const c = Astro.props.commune as Commune | undefined;

let ld: object[] = [];
if (c) {
  const s = SECTEURS.find((x) => x.slug === c.secteur)!;
  ld = [
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: `Conciergerie de villas à ${c.nom}`,
      serviceType: 'Gestion intégrale de villas en location saisonnière',
      provider: { '@id': `${SITE.url}/#organization` },
      areaServed: { '@type': 'City', name: c.nom, containedInPlace: { '@type': 'AdministrativeArea', name: s.departement } },
      url: `${SITE.url}/${c.slug}/`,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
    },
  ];
}
const secteurDeCommune = c ? SECTEURS.find((x) => x.slug === c.secteur)! : undefined;
const voisinesReseau = c ? c.voisinesReseau.map((s) => COMMUNES.find((x) => x.slug === s)).filter((x): x is Commune => !!x) : [];
---
{kind === 'secteur' && secteur && (
  <Base title={secteur.title} description={secteur.description} path={`/${secteur.slug}/`} crumbs={[{ nom: 'Nos secteurs', path: '/#secteurs' }, { nom: secteur.nom, path: `/${secteur.slug}/` }]}>
    <section class="opening">
      <div class="wrap opening-single">
        <p class="eyebrow">{secteur.region} · {secteur.departement}</p>
        <h1>Conciergerie de villas : {secteur.nom}</h1>
        <p class="chapo">{secteur.intro}</p>
        <div class="cta-actions" style="margin-top:26px">
          {secteur.ouvert
            ? <a class="btn btn-gold" href="#communes">Trouver ma commune</a>
            : <a class="btn btn-gold" href="#formulaire">Être prévenu de l’ouverture</a>}
          <a class="btn btn-line" href="/devenir-concierge/">Devenir concierge dans ce secteur</a>
        </div>
      </div>
    </section>
    <section class="band" id="communes">
      <div class="wrap stack-lg">
        <div class="head">
          <p class="eyebrow">{secteur.ouvert ? 'Nos communes' : 'Ouverture prochaine'}</p>
          <h2>{secteur.ouvert ? 'Choisissez votre commune' : `Les communes du secteur ${secteur.nom}`}</h2>
          {!secteur.ouvert && <p class="lead">Ce secteur ouvre prochainement. Propriétaires, laissez-nous vos coordonnées. Futurs concierges, chaque commune est à prendre.</p>}
        </div>
        <div class="cards">
          {secteur.communes.map((n) => {
            const ouverte = COMMUNES.find((x) => x.nom === n);
            return ouverte ? (
              <a class="card" href={`/${ouverte.slug}/`}>
                <h3>{n}</h3>
                <span>{ouverte.accueil.chapo.split('.')[0]}.</span>
                <span style="color:var(--gold);font-weight:600">Conciergerie {n} →</span>
              </a>
            ) : (
              <a class="card card-soon" href="/devenir-concierge/candidature/">
                <h3>{n}</h3>
                <span>Ouverture prochaine.</span>
                <span style="color:var(--gold);font-weight:600">Devenir le concierge de {n} →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
    {!secteur.ouvert && (
      <section class="band band-alt">
        <div class="wrap split-form">
          <div class="head">
            <p class="eyebrow">Propriétaires</p>
            <h2>Votre villa est dans ce secteur ?</h2>
            <p class="lead">Laissez-nous vos coordonnées : votre concierge AmaniHost vous contactera dès l’ouverture de votre commune pour vous rencontrer.</p>
          </div>
          <LeadForm commune={secteur.slug} communeNom={secteur.nom} titre="Être prévenu de l’ouverture" />
        </div>
      </section>
    )}
    <Offre />
    <Methode />
    <ConciergeBand />
  </Base>
)}

{kind === 'commune' && c && secteurDeCommune && (
  <Base
    title={c.accueil.title}
    description={c.accueil.description}
    path={`/${c.slug}/`}
    crumbs={[{ nom: 'Nos secteurs', path: '/#secteurs' }, { nom: secteurDeCommune.nom, path: `/${secteurDeCommune.slug}/` }, { nom: c.nom, path: `/${c.slug}/` }]}
    jsonld={ld}
    draft={c.aRelire}
  >
    <section class="opening">
      <div class="wrap opening-single">
        <p class="eyebrow">{secteurDeCommune.nom} · {c.codePostal}</p>
        <h1>{c.accueil.h1}</h1>
        <p class="chapo">{c.accueil.chapo}</p>
        <div class="cta-actions" style="margin-top:26px">
          <a class="btn btn-gold" href="#formulaire">Rencontrer votre concierge</a>
          <a class="btn btn-line" href={`/${c.slug}/estimation-revenus/`}>Estimer les revenus de ma villa</a>
        </div>
      </div>
    </section>

    <div class="body wrap">
      <article class="prose">
        {c.accueil.sections.map((s) => (
          <section>
            <h2>{s.h2}</h2>
            {s.paragraphes.map((p) => <p>{p}</p>)}
          </section>
        ))}
        {c.quartiers.length > 0 && (
          <section>
            <h2>Votre villa à {c.nom}, quartier par quartier</h2>
            <div class="cards">
              {c.quartiers.map((q) => (
                <a class="card" href={`/${c.slug}/${q.slug}/`}><h3>{q.menu}</h3><span>{q.chapo}</span></a>
              ))}
            </div>
          </section>
        )}
        {voisinesReseau.length > 0 && (
          <section>
            <h2>Nos communes voisines</h2>
            <ul class="links">
              {voisinesReseau.map((v) => <li><a href={`/${v.slug}/`}>Conciergerie de villas à {v.nom}</a></li>)}
            </ul>
          </section>
        )}
      </article>
      <aside class="aside">
        <LeadForm commune={c.slug} communeNom={c.nom} />
        <CommuneNav commune={c} />
      </aside>
    </div>

    <Pillars titre={`Pourquoi confier votre villa à AmaniHost à ${c.nom}`} />
    <Questions commune={c.nom} />
    <Offre commune={c.nom} />
    <Methode />
    <RendezVous commune={c.nom} />
    <Reviews />

    <section class="band">
      <div class="wrap stack-lg">
        <div class="head"><p class="eyebrow">Questions fréquentes</p><h2>Conciergerie à {c.nom} : vos questions</h2></div>
        <div class="faq" style="max-width:820px">
          {c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.r}</p></details>)}
        </div>
      </div>
    </section>

    <CtaBand
      titre={`Rencontrez votre concierge à ${c.nom}`}
      texte="Il vient chez vous, fait le tour de la villa et vous remet une proposition écrite. Sans engagement."
      href="#formulaire"
      bouton="Demander un rendez-vous"
      secondaireHref={`/${c.slug}/estimation-revenus/`}
      secondaire="Estimer mes revenus"
    />
  </Base>
)}
