---
import Base from '../../layouts/Base.astro';
import CandidatureForm from '../../components/CandidatureForm.astro';
import ConciergeNav from '../../components/ConciergeNav.astro';
---
<Base
  title="Candidature concierge de villas | AmaniHost"
  description="Candidatez pour devenir concierge de villas AmaniHost dans votre ville. Premier échange sous une semaine, conditions détaillées lors de l’entretien."
  path="/devenir-concierge/candidature/"
  crumbs={[{ nom: 'Devenir concierge', path: '/devenir-concierge/' }, { nom: 'Candidature', path: '/devenir-concierge/candidature/' }]}
  draft={true}
>
  <section class="opening">
    <div class="wrap opening-single">
      <p class="eyebrow">AmaniHost · Devenir concierge</p>
      <h1>Candidater pour devenir concierge AmaniHost</h1>
      <p class="chapo">Quelques questions pour faire connaissance. Nous vous rappelons sous une semaine pour un premier échange, où nous vous présentons le réseau et ses conditions.</p>
    </div>
  </section>
  <div class="body wrap">
    <div class="prose">
      <CandidatureForm />
      <section class="bloc">
        <h2>La suite</h2>
        <ol class="parcours">
          <li><span class="quand">Sous une semaine</span><h3>Un premier échange</h3><p>Par téléphone ou en visio : votre projet, votre ville, le réseau et ses conditions.</p></li>
          <li><span class="quand">Ensuite</span><h3>Une mise en situation</h3><p>Un rendez-vous fictif avec un propriétaire, pour voir si le métier vous correspond.</p></li>
          <li><span class="quand">Enfin</span><h3>Votre ville réservée</h3><p>Nous validons ensemble votre ville et le calendrier de formation avant la saison.</p></li>
        </ol>
      </section>
    </div>
    <aside class="aside"><ConciergeNav /></aside>
  </div>
</Base>
